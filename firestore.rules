rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection Healthcheck Document (Used by testConnection())
    match /test/connection {
      allow get: if true;
    }

    // User Profile - Validated by userId
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if false; // Disallow bulk scraping
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId);

      // Saved Articles Subcollection
      match /saved_articles/{articleId} {
        allow get, list: if isValidId(userId);
        allow create, update, delete: if isValidId(userId) && isValidId(articleId);
      }

      // Reading Sessions Subcollection
      match /reading_sessions/{sessionId} {
        allow get, list: if isValidId(userId);
        allow create, update, delete: if isValidId(userId) && isValidId(sessionId);
      }

      // Fact-Check Audits Subcollection
      match /audits/{auditId} {
        allow get, list: if isValidId(userId);
        allow create, update, delete: if isValidId(userId) && isValidId(auditId);
      }
    }

    // Social Wire Posts
    match /posts/{postId} {
      allow get, list: if true;
      allow create: if isValidId(postId) &&
        incoming().authorId is string &&
        incoming().authorId.size() >= 1 &&
        incoming().content is string &&
        incoming().content.size() <= 2000;
      allow update: if isValidId(postId);
      allow delete: if isValidId(postId);
    }

    // Discussion Comments (on news articles or wire posts)
    match /comments/{commentId} {
      allow get, list: if true;
      allow create: if isValidId(commentId) &&
        incoming().authorId is string &&
        incoming().content is string &&
        incoming().content.size() <= 2000;
      allow update, delete: if isValidId(commentId);
    }

    // Notifications (scoped by recipientId query)
    match /notifications/{notificationId} {
      allow get, list: if existing().recipientId is string && existing().recipientId.size() >= 1;
      allow create: if isValidId(notificationId) &&
        incoming().recipientId is string &&
        incoming().senderId is string;
      allow update, delete: if isValidId(notificationId);
    }

    // Private Direct Messages (scoped by recipientId, senderId, or participants query)
    match /messages/{messageId} {
      allow get, list: if (existing().recipientId is string && existing().recipientId.size() >= 1) ||
                       (existing().senderId is string && existing().senderId.size() >= 1) ||
                       (existing().participants is list && existing().participants.size() >= 1);
      allow create: if isValidId(messageId) &&
        incoming().senderId is string &&
        incoming().senderId.size() >= 1 &&
        incoming().recipientId is string &&
        incoming().recipientId.size() >= 1 &&
        incoming().content is string &&
        incoming().content.size() <= 2000;
      allow update, delete: if isValidId(messageId);
    }
  }
}
